{
  "family": "rag-definition",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "ecsTaskExecutionRole",
  "taskRoleArn": "rag-api-task-role",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "<IMAGE_NAME>",
      "command": ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--timeout-graceful-shutdown", "5"],
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "QDRANT_COLLECTION",
          "value": "enterprise_rag"
        },
        {
          "name": "RATE_LIMIT_PER_MINUTE",
          "value": "60"
        },
        {
          "name": "GROQ_MODEL",
          "value": "<GROQ_MODEL>"
        },
        {
          "name": "PORTKEY_CONFIG_ID",
          "value": "<PORTKEY_CONFIG_ID>"
        },
        {
          "name": "PORTKEY_CHAT_CONFIG_ID",
          "value": "<PORTKEY_CHAT_CONFIG_ID>"
        },
        {
          "name": "GCP_PROJECT_ID",
          "value": "<GCP_PROJECT_ID>"
        },
        {
          "name": "VERTEXAI_EMBEDDING_MODEL",
          "value": "<VERTEXAI_EMBEDDING_MODEL>"
        },
        {
          "name": "GROQ_SLUG",
          "value": "groq"
        },
        {
          "name": "GEMINI_SLUG",
          "value": "gemini"
        },
        {
          "name": "VERTEXAI_SLUG",
          "value": "vertex-ai"
        },
        {
          "name": "LANGSMITH_TRACING",
          "value": "true"
        },
        {
          "name": "LANGSMITH_ENDPOINT",
          "value": "https://api.smith.langchain.com"
        },
        {
          "name": "LANGSMITH_PROJECT",
          "value": "<LANGSMITH_PROJECT>"
        },
        {
          "name": "STRICT_STARTUP",
          "value": "false"
        },
        {
          "name": "LOGFIRE_IGNORE_NO_CONFIG",
          "value": "1"
        },
        {
          "name": "PYTHONUNBUFFERED",
          "value": "1"
        }
      ],
      "secrets": [
        {
          "name": "GROQ_API_KEY",
          "valueFrom": "<GROQ_API_KEY_ARN>"
        },
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "<GEMINI_API_KEY_ARN>"
        },
        {
          "name": "GOOGLE_APPLICATION_CREDENTIALS",
          "valueFrom": "<GCP_SERVICE_ACCOUNT_KEY_ARN>"
        },
        {
          "name": "QDRANT_URL",
          "valueFrom": "<QDRANT_URL_ARN>"
        },
        {
          "name": "QDRANT_API_KEY",
          "valueFrom": "<QDRANT_API_KEY_ARN>"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "<DATABASE_URL_ARN>"
        },
        {
          "name": "PORTKEY_API_KEY",
          "valueFrom": "<PORTKEY_API_KEY_ARN>"
        },
        {
          "name": "RAG_API_KEY",
          "valueFrom": "<RAG_API_KEY_ARN>"
        },
        {
          "name": "LOGFIRE_TOKEN",
          "valueFrom": "<LOGFIRE_TOKEN_ARN>"
        },
        {
          "name": "LANGSMITH_API_KEY",
          "valueFrom": "<LANGSMITH_API_KEY_ARN>"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rag-api",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}